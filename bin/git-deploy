# ═══════════════════════════════════════════════════════════════════════
# MENU PRINCIPAL
# ═══════════════════════════════════════════════════════════════════════

show_menu() {
    clear
    print_header "🚀 Git Deployment Workflow"

    local current_branch=$(get_current_branch)
    echo -e "${COLOR_BOLD}Branche actuelle:${COLOR_RESET} ${COLOR_GREEN}${current_branch}${COLOR_RESET}"
    echo ""

    echo -e "${COLOR_BOLD}DÉVELOPPEMENT:${COLOR_RESET}"
    echo "  1. 🌟 Créer une nouvelle feature branch"
    echo "  2. 🔀 Merger branche de travail → ${BRANCH_DEV}"
    echo "  3. 🔄 Merge flexible (source → cible au choix)"
    echo ""

    echo -e "${COLOR_BOLD}OPÉRATIONS GIT BASIQUES:${COLOR_RESET}"
    echo "  4. ➕ Add - Ajouter des fichiers"
    echo "  5. 💾 Commit - Créer un commit"
    echo "  6. ⬆️  Push - Pousser les changements"
    echo "  7. ⬇️  Pull - Récupérer les changements"
    echo "  8. 🔀 Changer de branche"
    echo ""

    echo -e "${COLOR_BOLD}OPÉRATIONS AVANCÉES:${COLOR_RESET}"
    echo "  9. ↩️  Annuler un commit"
    echo " 10. ⏮️  Revenir à un commit spécifique"
    echo " 11. 🚫 Annuler le suivi d'un fichier"
    echo " 12. 📜 Voir l'historique (log)"
    echo " 13. 💼 Stash - Sauvegarder temporairement"
    echo " 14. 🗑️  Annuler les modifications"
    echo " 15. 🗑️  Supprimer une branche"
    echo ""

    echo -e "${COLOR_BOLD}PROMOTION:${COLOR_RESET}"
    echo " 16. ⬆️  Promouvoir ${BRANCH_DEV} → ${BRANCH_STAGING}"
    echo " 17. 🎯 Promouvoir ${BRANCH_STAGING} → ${BRANCH_MAIN} (release)"
    echo " 18. 🚀 Déployer ${BRANCH_MAIN} → ${BRANCH_PROD}"
    echo ""

    echo -e "${COLOR_BOLD}GESTION & TAGS:${COLOR_RESET}"
    echo " 19. 🏷️  Créer un tag de version"
    echo " 20. 📋 Lister les tags"
    echo " 21. 🔄 Synchroniser la branche actuelle"
    echo ""

    echo -e "${COLOR_BOLD}INFORMATIONS:${COLOR_RESET}"
    echo " 22. 📊 Afficher le statut Git complet"
    echo " 23. 🌳 État des branches principales"
    echo ""

    echo " 24. ❓ Aide"
    echo "  0. ❌ Quitter"
    echo ""
}

interactive_mode() {
    while true; do
        show_menu

        read -p "$(echo -e "${COLOR_CYAN}Choisissez une option (0-24): ${COLOR_RESET}")" choice

        case $choice in
            1)
                create_feature_branch
                ;;
            2)
                merge_feature_to_dev
                ;;
            3)
                merge_branches_flexible
                ;;
            4)
                git_add
                ;;
            5)
                git_commit
                ;;
            6)
                git_push
                ;;
            7)
                git_pull
                ;;
            8)
                switch_branch
                ;;
            9)
                undo_commit
                ;;
            10)
                reset_to_commit
                ;;
            11)
                untrack_file
                ;;
            12)
                show_log
                ;;
            13)
                stash_changes
                ;;
            14)
                discard_changes
                ;;
            15)
                delete_branch
                ;;
            16)
                promote_dev_to_staging
                ;;
            17)
                promote_staging_to_main
                ;;
            18)
                deploy_main_to_prod
                ;;
            19)
                create_version_tag
                ;;
            20)
                list_tags
                ;;
            21)
                sync_branch
                ;;
            22)
                show_status
                ;;
            23)
                show_branches_status
                ;;
            24)
                show_help
                ;;
            0)
                print_info "Au revoir!"
                exit 0
                ;;
            *)
                print_error "Option invalide"
                ;;
        esac

        echo ""
        read -p "$(echo -e "${COLOR_CYAN}Appuyez sur Entrée pour continuer...${COLOR_RESET}")"
    done
}

# ═══════════════════════════════════════════════════════════════════════
# POINT D'ENTRÉE
# ═══════════════════════════════════════════════════════════════════════

main() {
    # Notifier si une mise à jour du framework est disponible (throttlé, non fatal)
    command -v devops_check_updates_auto >/dev/null 2>&1 && devops_check_updates_auto || true

    # Extraire d'abord les flags de configuration des branches (précédence max).
    # Les autres arguments sont conservés pour le dispatch ci-dessous.
    local positional=()
    while [ $# -gt 0 ]; do
        case "$1" in
            --branch-dev)     FLAG_BRANCH_DEV="${2:-}"; shift 2 ;;
            --branch-staging) FLAG_BRANCH_STAGING="${2:-}"; shift 2 ;;
            --branch-main)    FLAG_BRANCH_MAIN="${2:-}"; shift 2 ;;
            --branch-prod)    FLAG_BRANCH_PROD="${2:-}"; shift 2 ;;
            --feature-prefix) FLAG_FEATURE_PREFIX="${2:-}"; shift 2 ;;
            --config)         DEVOPS_CONFIG_FILE="${2:-}"; shift 2 ;;
            *)                positional+=("$1"); shift ;;
        esac
    done
    set -- ${positional[@]+"${positional[@]}"}

    # Traiter les arguments qui n'ont pas besoin d'un repo Git
    case "${1:-}" in
        --help|-h)
            show_help
            exit 0
            ;;
        --status|-s)
            # Vérifier qu'on est dans un repo Git
            check_git_repo
            configure_branches
            show_status
            exit 0
            ;;
        --branches|-b)
            # Vérifier qu'on est dans un repo Git
            check_git_repo
            configure_branches
            show_branches_status
            exit 0
            ;;
        "")
            # Vérifier qu'on est dans un repo Git
            check_git_repo
            configure_branches
            interactive_mode
            ;;
        *)
            print_error "Option inconnue: $1"
            echo "Utilisez --help pour voir l'aide"
            exit 1
            ;;
    esac
}

# Lancer le script
main "$@"
